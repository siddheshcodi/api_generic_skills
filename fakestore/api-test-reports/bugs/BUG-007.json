    "Observe 201 - account created with a duplicate username"
  ],
  "request": {
    "curl": "curl -s -i -X POST 'https://fakestoreapi.com/users' -H 'Content-Type: application/json' -d '{\"username\":\"mor_2314\",\"email\":\"mor_2314@example.com\",\"password\":\"<PASSWORD>\"}'"
  },
  "expected": "409 Conflict (or 400) 'username already exists'.",
