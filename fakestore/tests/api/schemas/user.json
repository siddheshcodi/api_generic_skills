{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "user",
  "type": "object",
  "required": [
    "id",
    "email",
    "username",
    "name",
    "address",
    "phone"
  ],
  "properties": {
    "id": {
      "type": "integer"
    },
    "email": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "name": {
      "type": "object",
      "required": [
        "firstname",
        "lastname"
      ],
      "properties": {
        "firstname": {
          "type": "string"
        },
        "lastname": {
          "type": "string"
        }
      }
    },
    "address": {
      "type": "object",
      "required": [
        "city",
        "street",
        "number",
        "zipcode"
      ],
      "properties": {
        "city": {
          "type": "string"
        },
        "street": {
          "type": "string"
        },
        "number": {
          "type": "integer"
        },
        "zipcode": {
          "type": "string"
        }
      }
    }
  }
}